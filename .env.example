# Copy to .env (git-ignored) to keep your characters, chats, worlds and art outside this checkout.
# LOST_TALES_DATA_DIR=/absolute/path/to/lost-tales-data

# Optional LuxTTS voice-cloning server (Settings → Voice → LuxTTS). The browser never sees these.
# LUXTTS_URL=http://your-luxtts-host:8812
# LUXTTS_TOKEN=
# Voice sample file (from Settings → Voice) used when a line has no voice of its own:
# LUXTTS_DEFAULT_REFERENCE=
